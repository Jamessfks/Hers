{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],

    /*
     * Node runs the server's TypeScript directly by stripping types, and only
     * erasable syntax survives that. `verbatimModuleSyntax` keeps type-only
     * imports marked so they vanish cleanly, and `erasableSyntaxOnly` fails the
     * build on an `enum` or a parameter property rather than at runtime on
     * someone else's machine.
     */
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
