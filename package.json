{
  "name": "hers",
  "version": "2.0.7",
  "private": true,
  "description": "Hers \u2014 a fully customizable AI companion that runs entirely on your own computer. She sees your screen, sees you, hears you, remembers, and speaks first.",
  "author": "Zicheng Zhao",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "app": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "node --test --test-timeout=60000 \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "doctor": "node src/server/doctor.ts",
    "audit": "node scripts/audit.ts",
    "audit:bridges": "node scripts/audit-bridges.ts",
    "probe:affective": "node scripts/probe-affective.ts",
    "probe:client-content": "node scripts/probe-client-content.ts",
    "probe:delivery": "node scripts/probe-delivery.ts"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "jpeg-js": "^0.4.4",
    "opusscript": "^0.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.14"
  }
}
