{
  "name": "anna-companion",
  "version": "2.0.0",
  "private": true,
  "description": "Anna — an AI companion who can see your screen, see you, and hear you, in your browser and on your phone.",
  "author": "Zicheng Zhao",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "node --test --test-timeout=60000 \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "doctor": "node src/server/doctor.ts",
    "audit": "node scripts/audit.ts",
    "audit:bridges": "node scripts/audit-bridges.ts"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@livekit/rtc-node": "^0.13.33",
    "jpeg-js": "^0.4.4",
    "livekit-server-sdk": "^2.17.0",
    "opusscript": "^0.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.14"
  }
}
